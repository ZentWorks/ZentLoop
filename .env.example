ZENTLOOP_ADMIN_USER=admin
# Optional. If empty/unset, ZentLoop generates a random password at each start and prints it to the container log.
ZENTLOOP_ADMIN_PASSWORD=
# auto | direct | generic | cloudflare
# auto is recommended for mixed ingress on one instance.
ZENTLOOP_PROXY_MODE=auto
# Optional per-target overrides. Exact hosts and *.wildcards are supported.
# Example: trap.example.com=cloudflare,*.old.example.com=generic,203.0.113.10=direct
ZENTLOOP_PROXY_RULES=
TZ=Europe/Berlin
ZENTLOOP_PUBLIC_PORT=8080
ZENTLOOP_ADMIN_BIND=127.0.0.1
ZENTLOOP_ADMIN_PORT=9090
ZENTLOOP_MAX_CONCURRENT=256
# Persistent HTTP/SSH/intelligence logs are deleted after this many days. Hard maximum: 30.
ZENTLOOP_RETENTION_DAYS=30

# Optional public SSH deception trap. This is a fully virtual shell: attacker commands never
# execute on the container, never read the real filesystem and never open outbound connections.
# On a dedicated ZentLoop IP, TCP/22 is the recommended lure port.
ZENTLOOP_SSH_ENABLED=false
ZENTLOOP_SSH_ADDR=0.0.0.0:22
ZENTLOOP_SSH_HOST_KEY_PATH=/data/ssh_trap_host_ed25519_key
ZENTLOOP_SSH_MAX_CONCURRENT=64
ZENTLOOP_SSH_MAX_PER_IP=4
ZENTLOOP_SSH_IDLE_SECONDS=120
ZENTLOOP_SSH_MAX_SESSION_MINUTES=30
ZENTLOOP_SSH_MAX_AUTH_TRIES=6
# Generic bridge-compose helper; set to 22 only if the Docker host's TCP/22 is free.
ZENTLOOP_SSH_PUBLIC_PORT=2222

# Optional internal management SSH. Public-key authentication only; no shell, SCP, SFTP or forwarding.
# A successful login opens the same live view as `zentloop top` directly.
ZENTLOOP_ADMIN_SSH_ENABLED=false
ZENTLOOP_ADMIN_SSH_ADDR=0.0.0.0:22222
ZENTLOOP_ADMIN_SSH_USER=admin
# Paste one complete OpenSSH public key; quote the value because it contains spaces.
# Example: ZENTLOOP_ADMIN_SSH_AUTHORIZED_KEY="ssh-ed25519 AAAA... xyz@mac"
# Generate a dedicated key on macOS:
# ssh-keygen -t ed25519 -a 100 -C "zentloop-admin"
# Suggested path: /Users/YourName/.ssh/zentloop_admin
ZENTLOOP_ADMIN_SSH_AUTHORIZED_KEY=
# Generated automatically on first start and persisted in /data so known_hosts stays stable.
ZENTLOOP_ADMIN_SSH_HOST_KEY_PATH=/data/ssh_host_ed25519_key
# Generic bridge-compose helper; management remains loopback-only by default.
ZENTLOOP_ADMIN_SSH_BIND=127.0.0.1
ZENTLOOP_ADMIN_SSH_PORT=22222

# Sessions disappear from LIVE views after this many quiet minutes.
ZENTLOOP_LIVE_SESSION_MINUTES=5
# Same cookie or IP + User-Agent can resume its prior deception state within this window.
# 720 hours = 30 days.
ZENTLOOP_RESUME_WINDOW_HOURS=720

# Optional offline country lookup for direct/generic traffic.
# Put a MaxMind-compatible country MMDB here; DB-IP Country Lite works.
ZENTLOOP_GEOIP_DB=/data/dbip-country-lite.mmdb
# Download/update DB-IP Country Lite monthly at container startup. No visitor IPs are sent to DB-IP.
ZENTLOOP_GEOIP_AUTO_UPDATE=true

# Official crawler verification. ZentLoop fetches only built-in HTTPS endpoints
# published by supported providers and caches CIDR ranges under /data.
ZENTLOOP_OFFICIAL_BOTS_ENABLED=true
ZENTLOOP_OFFICIAL_BOTS_REFRESH_HOURS=24
ZENTLOOP_OFFICIAL_BOTS_CACHE=/data/official-bots.json

# Reverse-proxy integration protocol (catch-all / unmatched hosts).
# Leave the secret empty for simple integrations from a private Docker/LAN peer.
# Set a strong shared secret when the upstream integration can sign metadata.
ZENTLOOP_INTEGRATION_SECRET=
ZENTLOOP_INTEGRATION_MAX_SKEW_SECONDS=300
